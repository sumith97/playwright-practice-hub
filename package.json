{
  "name": "playwright-practice-hub",
  "version": "1.0.0",
  "private": true,
  "description": "A deliberately testable full-stack web app for practicing Playwright — basic, intermediate and advanced challenges.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "typecheck": "tsc -p apps/web --noEmit",
    "test:examples": "playwright test --project=chromium",
    "test:examples:all": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "axe-core": "^4.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
